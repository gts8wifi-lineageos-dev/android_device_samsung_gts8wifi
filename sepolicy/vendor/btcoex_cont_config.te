type btcoex_cont_config, domain;
type btcoex_cont_config_exec, exec_type, vendor_file_type, file_type;

init_daemon_domain(btcoex_cont_config)

allow btcoex_cont_config self:capability { net_admin net_raw };

allow btcoex_cont_config self:udp_socket { ioctl create };
allowxperm btcoex_cont_config self:udp_socket ioctl { SIOCGIFFLAGS SIOCSIFFLAGS };

allow btcoex_cont_config sysfs_wifi:dir search;
allow btcoex_cont_config sysfs_wifi:file rw_file_perms;
