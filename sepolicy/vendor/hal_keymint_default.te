hal_client_domain(hal_keymint_default, hal_weaver)

r_dir_file(hal_keymint_default, dak_efs_file)

allow hal_keymint_default efs_file:dir search;
allow hal_keymint_default mnt_vendor_file:dir r_dir_perms;
allow hal_keymint_default sec_efs_file:dir r_dir_perms;
allow hal_keymint_default vendor_keymaster_data_file:dir { create_dir_perms watch watch_reads };
allow hal_keymint_default vendor_keymaster_data_file:file { create_file_perms watch watch_reads };

allow hal_keymint_default vendor_dmabuf_qseecom_heap_device:chr_file { read open ioctl };
allow hal_keymint_default vendor_dmabuf_qseecom_ta_heap_device:chr_file { read open ioctl };
allow hal_keymint_default vendor_dmabuf_secure_sp_tz_heap_device:chr_file { read open ioctl };

allow hal_keymint_default {
    ssp_device
    tee_device
    tz_device
    vendor_skp_device
    vendor_sp_keymaster_device
    vendor_spcom_device
    vendor_spss_utils_device
}:chr_file rw_file_perms;

allowxperm hal_keymint_default vendor_spss_utils_device:chr_file ioctl { 0x5302 };

allow hal_keymint_default hermes_socket:sock_file write;
allow hal_keymint_default hermesd:unix_stream_socket connectto;

binder_call(hal_keymint_default, vendor_hal_keymaster_qti)

set_prop(hal_keymint_default, ctl_start_prop)
get_prop(hal_keymint_default, vendor_spcomlib_prop)
get_prop(hal_keymint_default, vendor_tee_listener_prop)
