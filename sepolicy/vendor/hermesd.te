type hermesd, domain;
type hermesd_exec, exec_type, vendor_file_type, file_type;

init_daemon_domain(hermesd)
hal_server_domain(hermesd, hal_weaver)
hal_client_domain(hermesd, hal_keymint)
hal_server_domain(hermesd, hal_gatekeeper)

binder_use(hermesd)
hwbinder_use(hermesd)

allow hermesd self:capability2 wake_alarm;

allow hermesd vendor_gatekeeper_data_file:dir create_dir_perms;
allow hermesd vendor_gatekeeper_data_file:file create_file_perms;

allow hermesd {
    k250a_device
    ssp_device
    tee_device
}:chr_file rw_file_perms;

allow hermesd vendor_dmabuf_qseecom_heap_device:chr_file { read open ioctl };
allow hermesd vendor_dmabuf_qseecom_ta_heap_device:chr_file { read open ioctl };

get_prop(hermesd, vendor_spcomlib_prop)
get_prop(hermesd, vendor_tee_listener_prop)
set_prop(hermesd, vendor_securehw_prop)
set_prop(hermesd, vendor_securenvm_prop)
