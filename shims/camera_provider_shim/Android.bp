// Device-local variant of hardware/lineage/compat's libcamera_provider_shim
// (same source, distinct module name — kati rejects duplicate module names
// even across soong namespaces): the old-ABI CameraDevice constructors that
// Samsung's A12-era camera blobs reference forward into the
// camera.device@3.x-impl.samsung variants, which carry the Samsung-extended
// camera3 struct layouts UniHAL expects. Linking the plain AOSP impls (as
// upstream does) would pull four dead libraries into the image whose
// symbols must never win over the .samsung ones.
cc_library_shared {
    name: "libcamera_provider_shim.samsung",
    shared_libs: [
        "camera.device@1.0-impl",
        "camera.device@3.2-impl.samsung",
        "camera.device@3.3-impl.samsung",
        "camera.device@3.4-impl.samsung",
        "camera.device@3.5-impl.samsung",
        "libcamera_metadata",
    ],
    include_dirs: [
        "hardware/interfaces/camera/common/default/include/",
        "hardware/libhardware/include",
    ],
    srcs: ["camera_provider.cpp"],
    vendor: true,
}
